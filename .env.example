XAI_API_KEY=
IBKR_HOST=127.0.0.1
IBKR_PORT=4002
IBKR_CLIENT_ID=1
IBKR_ACCOUNT=
IBKR_BUDGET_TAG=AvailableFunds
IBKR_BUDGET_CURRENCY=EUR
IBKR_AUDIT_DIR=audit
IBKR_LIMIT_BUFFER_BPS=25
IBKR_MD_WAIT=1.5

# Execution window (Europe/Paris)
EU_SESSION_START=08:35
EU_SESSION_END=17:40
EU_RUN_INTERVAL_MIN=60

# Grok memory (48h) - full history in compact form (no URLs)
IBKR_MEMORY_LOOKBACK_HOURS=48

# Notifications par email https://myaccount.google.com/apppasswords
ALERT_SMTP_SERVER=smtp.gmail.com
ALERT_SMTP_PORT=587
ALERT_SMTP_USER=votre.email@gmail.com
ALERT_SMTP_PASSWORD=votre_mot_de_passe_application
ALERT_EMAIL_TO=destinataire@example.com
